<UserControl x:Class="KuaiyunClient.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="我的" FontSize="24" FontWeight="Bold" Margin="4,4,0,14" />

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="21"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="EmailText" Text="--" FontSize="16" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ExpiryText" Text="到期时间 --"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel>
                <Button Tag="Orders" Style="{StaticResource MenuRowButtonStyle}" Click="MenuButton_Click">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="17" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="我的订单" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/></Grid>
                </Button>
                <Button Tag="Invite" Style="{StaticResource MenuRowButtonStyle}" Margin="0,8,0,0" Click="MenuButton_Click">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="17" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="我的邀请" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/></Grid>
                </Button>
                <Button Tag="Website" Style="{StaticResource MenuRowButtonStyle}" Margin="0,8,0,0" Click="MenuButton_Click">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="17" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="官网地址" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/></Grid>
                </Button>
                <Button Tag="Announcement" Style="{StaticResource MenuRowButtonStyle}" Margin="0,8,0,0" Click="MenuButton_Click">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><TextBlock Text="&#xE7F7;" FontFamily="Segoe MDL2 Assets" FontSize="17" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="系统公告" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/></Grid>
                </Button>
                <Button Tag="Support" Style="{StaticResource MenuRowButtonStyle}" Margin="0,8,0,0" Click="MenuButton_Click">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="17" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="在线客服" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/></Grid>
                </Button>
                <Button Tag="Telegram" Style="{StaticResource MenuRowButtonStyle}" Margin="0,8,0,0" Click="MenuButton_Click">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="17" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="TG 群组" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/></Grid>
                </Button>
                <Button Tag="Password" Style="{StaticResource MenuRowButtonStyle}" Margin="0,8,0,0" Click="MenuButton_Click">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="17" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="修改密码" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/></Grid>
                </Button>
                <Button Tag="Logs" Style="{StaticResource MenuRowButtonStyle}" Margin="0,8,0,0" Click="MenuButton_Click">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="17" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="系统日志" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/></Grid>
                </Button>
                <Button Tag="Version" Style="{StaticResource MenuRowButtonStyle}" Margin="0,8,0,0" Click="MenuButton_Click">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="17" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="检查版本" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/></Grid>
                </Button>
                <Button Tag="Logout" Style="{StaticResource MenuRowButtonStyle}" Margin="0,8,0,6" Click="MenuButton_Click">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#E15454" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="退出" Foreground="#E15454" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" Foreground="#E15454" VerticalAlignment="Center"/></Grid>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
