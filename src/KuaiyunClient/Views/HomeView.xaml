<UserControl x:Class="KuaiyunClient.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Button Style="{StaticResource MenuRowButtonStyle}"
                    Height="66"
                    Background="White"
                    Click="AnnouncementButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="17" Background="#EEF2F8">
                        <TextBlock Text="&#xE7F7;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="#7C899B" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="系统公告" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                        <TextBlock x:Name="AnnouncementText" Text="暂无公告"
                                   FontSize="13" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                               Foreground="#8793A6" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="剩余流量" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                        <TextBlock x:Name="TrafficText" Text="--"
                                   FontWeight="Bold" FontSize="24" Margin="0,5,0,0" />
                        <TextBlock x:Name="TotalTrafficText" Text="总流量 --"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,8,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Background="{StaticResource LineBrush}" />

                    <StackPanel Grid.Column="2" Margin="16,0,0,0" HorizontalAlignment="Right">
                        <TextBlock Text="当前套餐" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" HorizontalAlignment="Right" />
                        <TextBlock x:Name="PlanText" Text="未订阅套餐"
                                   FontWeight="Bold" FontSize="20" Margin="0,5,0,0"
                                   HorizontalAlignment="Right" />
                        <TextBlock x:Name="ExpiryText" Text="到期时间 --"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                   Margin="0,8,0,0" HorizontalAlignment="Right" />
                        <TextBlock x:Name="ResetText" Text="流量重置 --"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                   Margin="0,4,0,0" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="18,24">
                <StackPanel HorizontalAlignment="Center">
                    <Button x:Name="ConnectionButton"
                            Width="116" Height="116"
                            Background="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="ConnectionButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse Fill="{TemplateBinding Background}"
                                             Stroke="#E2E7EF" StrokeThickness="1">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="6"
                                                              Opacity="0.18" Color="#8090A8" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="44" Foreground="#171D2A"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.88" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.55" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock x:Name="ConnectionStateText" Text="未连接"
                               FontSize="23" FontWeight="Bold" Margin="0,18,0,0"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="CurrentNodeText" Text="暂无可用线路"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="13" Margin="0,8,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <Button Style="{StaticResource MenuRowButtonStyle}"
                    Margin="0,12,0,0"
                    Click="ServerButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="28" CornerRadius="5" ClipToBounds="True"
                            Background="White" BorderBrush="#DDE3EC" BorderThickness="1">
                        <Image x:Name="CurrentFlagImage" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="当前线路" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                        <TextBlock x:Name="ServerNameText" Text="暂无可用线路"
                                   FontWeight="SemiBold" FontSize="14" Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                               Foreground="#677386" FontSize="17"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Button Style="{StaticResource MenuRowButtonStyle}" Margin="0,10,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="17" Background="#E7F7F4">
                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="{StaticResource AccentDarkBrush}" FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="智能模式" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                               Foreground="#677386" FontSize="17"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
