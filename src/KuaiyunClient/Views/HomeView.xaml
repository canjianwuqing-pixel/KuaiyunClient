<UserControl x:Class="KuaiyunClient.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="首页" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="账户与连接状态"
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="0,6,0,0" />
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,24,0,18">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="账号" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="EmailText" Text="--" FontSize="17"
                               FontWeight="SemiBold" Margin="0,10,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="剩余流量" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="TrafficText" Text="--" FontSize="17"
                               FontWeight="SemiBold" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="到期时间" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="ExpiryText" Text="--" FontSize="17"
                               FontWeight="SemiBold" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="ConnectionStateText" Text="未连接"
                               FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="CurrentNodeText" Text="当前节点：--"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,10,0,0" HorizontalAlignment="Center" />
                    <Button x:Name="ConnectionButton" Content="连接"
                            Width="180" Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,26,0,0" Click="ConnectionButton_Click" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="连接功能将在 Mihomo 服务接入后启用。"
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
