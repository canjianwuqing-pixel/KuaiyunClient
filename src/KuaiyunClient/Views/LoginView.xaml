<UserControl x:Class="KuaiyunClient.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" Margin="18">
            <Border Width="64" Height="64" CornerRadius="20"
                    Background="{StaticResource AccentBrush}"
                    HorizontalAlignment="Center">
                <TextBlock Text="K" Foreground="White" FontSize="30" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="快云加速" FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,14,0,0" />
            <TextBlock Text="登录后开始使用"
                       Foreground="{StaticResource MutedTextBrush}"
                       HorizontalAlignment="Center" Margin="0,6,0,22" />

            <Border Style="{StaticResource CardStyle}" Padding="22">
                <StackPanel>
                    <TextBlock Text="邮箱账号" FontWeight="SemiBold" Margin="2,0,0,8" />
                    <TextBox x:Name="EmailInput" Height="46" Padding="12,9"
                             Background="#F5F7FA" BorderBrush="{StaticResource LineBrush}" />

                    <TextBlock Text="登录密码" FontWeight="SemiBold" Margin="2,18,0,8" />
                    <PasswordBox x:Name="PasswordInput" Height="46" Padding="12,9"
                                 Background="#F5F7FA" BorderBrush="{StaticResource LineBrush}" />

                    <Button x:Name="LoginButton" Content="登录"
                            Style="{StaticResource RoundedButtonStyle}"
                            Margin="0,22,0,0" Click="LoginButton_Click" />

                    <TextBlock x:Name="StatusText" Text=""
                               Foreground="{StaticResource MutedTextBrush}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
