<UserControl x:Class="KuaiyunClient.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="登录快云加速" FontSize="30" FontWeight="Bold" />
            <TextBlock Text="使用已购买套餐的账号登录"
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="0,8,0,30" />

            <TextBlock Text="邮箱账号" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBox x:Name="EmailInput" Height="44" Padding="12,8"
                     Background="White" BorderBrush="{StaticResource LineBrush}" />

            <TextBlock Text="登录密码" FontWeight="SemiBold" Margin="0,20,0,8" />
            <PasswordBox x:Name="PasswordInput" Height="44" Padding="12,8"
                         Background="White" BorderBrush="{StaticResource LineBrush}" />

            <Button x:Name="LoginButton" Content="登录"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,26,0,0" Click="LoginButton_Click" />

            <TextBlock x:Name="StatusText" Text=""
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap" Margin="0,16,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
