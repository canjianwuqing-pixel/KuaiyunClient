<UserControl x:Class="KuaiyunClient.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="设置" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="客户端基础选项"
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="0,6,0,22" />

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="启动与连接" FontSize="16" FontWeight="SemiBold"
                               Margin="0,0,0,16" />
                    <CheckBox x:Name="StartWithWindowsCheckBox"
                              Content="开机自动启动" Margin="0,0,0,14"
                              Checked="OptionChanged" Unchecked="OptionChanged" />
                    <CheckBox x:Name="AutoConnectCheckBox"
                              Content="启动后自动连接" Margin="0,0,0,14"
                              Checked="OptionChanged" Unchecked="OptionChanged" />
                    <CheckBox x:Name="SystemProxyCheckBox"
                              Content="使用 Windows 系统代理"
                              IsChecked="True"
                              Checked="OptionChanged" Unchecked="OptionChanged" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="云端配置" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="重新读取 OSS 中的品牌、API 和内置代理配置"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                    <Button Content="重新读取" Width="110" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}"
                            Click="ReloadConfigButton_Click" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="客户端更新" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionText" Text="当前版本：0.1.0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                    <Button Content="检查更新" Width="110" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}"
                            Click="CheckUpdateButton_Click" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
