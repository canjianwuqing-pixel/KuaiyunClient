<UserControl x:Class="KuaiyunClient.Views.PurchaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="购买套餐" FontSize="24" FontWeight="Bold" Margin="4,4,0,14" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="当前套餐" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                    <TextBlock x:Name="CurrentPlanText" Text="当前套餐"
                               FontSize="22" FontWeight="Bold" Margin="0,7,0,0" />
                    <TextBlock x:Name="PlanExpiryText" Text="到期时间 --"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="选择适合你的套餐" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="在官方购买页面查看套餐、续费或升级。"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,18" />
                    <Button Content="进入购买页面"
                            Style="{StaticResource RoundedButtonStyle}"
                            Click="PurchaseButton_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
