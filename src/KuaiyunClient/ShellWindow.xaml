<Window x:Class="KuaiyunClient.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快云加速"
        Width="460"
        Height="820"
        MinWidth="430"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ContentControl x:Name="PageHost" Margin="14,14,14,8" />

        <Border x:Name="BottomNavigation"
                Grid.Row="1"
                Visibility="Collapsed"
                Margin="10,2,10,12"
                Padding="7"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.10" Color="#60708A" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Button x:Name="HomeNavButton"
                        Grid.Column="0"
                        Tag="Home"
                        Style="{StaticResource BottomNavButtonStyle}"
                        Click="NavigationButton_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="22" HorizontalAlignment="Center" />
                        <TextBlock Text="首页" FontSize="12" Margin="0,4,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="PurchaseNavButton"
                        Grid.Column="1"
                        Tag="Purchase"
                        Style="{StaticResource BottomNavButtonStyle}"
                        Click="NavigationButton_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="22" HorizontalAlignment="Center" />
                        <TextBlock Text="购买" FontSize="12" Margin="0,4,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="ProfileNavButton"
                        Grid.Column="2"
                        Tag="Profile"
                        Style="{StaticResource BottomNavButtonStyle}"
                        Click="NavigationButton_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="22" HorizontalAlignment="Center" />
                        <TextBlock Text="我的" FontSize="12" Margin="0,4,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
