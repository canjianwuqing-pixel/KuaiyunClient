<Window x:Class="KuaiyunClient.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快云加速"
        Width="980"
        Height="660"
        MinWidth="880"
        MinHeight="580"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="22,26,18,28">
                    <Border Width="42" Height="42" CornerRadius="13"
                            Background="{StaticResource AccentBrush}"
                            HorizontalAlignment="Left">
                        <TextBlock Text="K" Foreground="White" FontSize="22"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="快云加速" Foreground="White" FontSize="19"
                               FontWeight="Bold" Margin="0,12,0,0" />
                    <TextBlock Text="Windows 客户端" Foreground="#8FA5BB"
                               FontSize="11" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button x:Name="LoginNavButton" Content="登录" Tag="Login"
                            Style="{StaticResource NavButtonStyle}" Click="NavigationButton_Click" />
                    <Button x:Name="HomeNavButton" Content="首页" Tag="Home"
                            Style="{StaticResource NavButtonStyle}" Click="NavigationButton_Click" />
                    <Button x:Name="NodesNavButton" Content="节点" Tag="Nodes"
                            Style="{StaticResource NavButtonStyle}" Click="NavigationButton_Click" />
                    <Button x:Name="SettingsNavButton" Content="设置" Tag="Settings"
                            Style="{StaticResource NavButtonStyle}" Click="NavigationButton_Click" />
                </StackPanel>

                <Border Grid.Row="2" Margin="16,0,16,20" Padding="12"
                        CornerRadius="10" Background="#1A3049">
                    <StackPanel>
                        <TextBlock Text="当前阶段" Foreground="#8FA5BB" FontSize="10" />
                        <TextBlock Text="v0.1 框架" Foreground="White" FontSize="12"
                                   FontWeight="SemiBold" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="30">
            <ContentControl x:Name="PageHost" />
        </Grid>
    </Grid>
</Window>
