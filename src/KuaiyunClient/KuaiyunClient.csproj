<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KuaiyunClient</AssemblyName>
    <RootNamespace>KuaiyunClient</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\config\bootstrap.example.json"
          Link="bootstrap.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />

    <Content Include="core\mihomo.exe"
             Condition="Exists('core\mihomo.exe')"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />

    <None Include="core\version.txt"
          Condition="Exists('core\version.txt')"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
